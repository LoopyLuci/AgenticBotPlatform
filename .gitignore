.env
config/providers.yaml
config/file_share.yaml
data/env_backups/
data/bot_instances_backups/
__pycache__/
*.pyc
.venv/
venv/
data/*.db
data/*.db-wal
data/*.db-shm
data/pre_migration_backup/
data/inbox/
data/attachments/
data/agent_workspaces/
data/models_dev_cache.json
# Trained Support Bot model files (bot/support_bot/model_io.py) — a
# per-install artifact regenerated by retraining, not source.
data/support_bot_models/
# Per-instance isolated Hermes homes (bot_instances.desktop_project's
# hermes_home counterpart) — each one is a real, live clone of a Hermes
# account's own state (config.yaml, state.db, session history, and
# whatever auth/session tokens that account has) for an isolated
# hermes_gateway-backed bot instance. Never committed, same as data/*.db.
data/hermes_homes/
logs/*.log
logs/local_pipeline/

# Tauri desktop shell build output (target/ also holds a copy of bot/,
# config/, and .venv/ per tauri.conf.json's bundle.resources — regenerated
# on every build, never hand-edit anything under it)
desktop-app/src-tauri/target/
desktop-app/src-tauri/gen/schemas/

# Local agent handoff notes — not user-facing docs, never published
PLAN.md
