{
  "id": "gemini",
  "name": "Gemini",
  "version": 1,
  "hosts": ["gemini.google.com"],
  "home": "https://gemini.google.com/app",
  "tos_note": "Uses your own logged-in Gemini session in a browser tab. Gemini's terms of service apply to how you use it, and rate limits are enforced. ABP never types your password and stops at any login or CAPTCHA.",
  "login": {
    "logged_out": ["a[href*='ServiceLogin']", "aria:Sign in", "text:a:Sign in"],
    "ready": ["rich-textarea .ql-editor", "div.ql-editor[contenteditable=true]", "div[contenteditable=true][role=textbox]"]
  },
  "new_chat": { "navigate": "https://gemini.google.com/app" },
  "compose": {
    "input": ["rich-textarea .ql-editor", "div.ql-editor[contenteditable=true]", "div[contenteditable=true][role=textbox]"],
    "submit": ["button.send-button", "aria:Send message", "aria:Send"],
    "key": "Enter",
    "mode": "paste"
  },
  "stream": {
    "assistant": ["message-content", "div.model-response-text", ".response-container .markdown"],
    "generating": ["aria:Stop response", "aria:Stop", "button.stop"],
    "quiet_ms": 1500,
    "strip": ["button", "[aria-hidden=true]", ".sr-only"]
  },
  "errors": [
    { "within": ["[role=alert]", "[role=status]", "[data-testid*=error]", "[class*=toast]"],
      "match": "(rate limit|too many requests|reached (your|the) (message )?limit|usage limit|try again (later|in))",
      "code": "E_RATE_LIMITED", "message": "the site says you have reached its usage limit" }
  ],
  "limits": { "min_interval_ms": 4000, "max_prompt_chars": 30000 },
  "selftest": { "prompt": "Reply with exactly: ABP-OK", "expect": "ABP-OK" }
}
