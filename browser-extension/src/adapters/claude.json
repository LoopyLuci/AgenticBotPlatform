{
  "id": "claude",
  "name": "Claude",
  "version": 1,
  "hosts": ["claude.ai"],
  "home": "https://claude.ai/new",
  "tos_note": "Uses your own logged-in Claude session in a browser tab. Claude's terms of service apply to how you use it, and rate limits are enforced. ABP never types your password and stops at any login or CAPTCHA.",
  "login": {
    "logged_out": ["a[href*='/login']", "text:button:Continue with"],
    "ready": ["div.ProseMirror[contenteditable=true]", "div[contenteditable=true][role=textbox]", "fieldset div[contenteditable=true]"]
  },
  "new_chat": { "navigate": "https://claude.ai/new" },
  "compose": {
    "input": ["div.ProseMirror[contenteditable=true]", "div[contenteditable=true][role=textbox]", "fieldset div[contenteditable=true]"],
    "submit": ["aria:Send message", "aria:Send", "button[type=submit]"],
    "key": "Enter",
    "mode": "paste"
  },
  "stream": {
    "assistant": ["[data-testid=assistant-message]", "div.font-claude-message", "[data-is-streaming]"],
    "generating": ["aria:Stop response", "aria:Stop"],
    "quiet_ms": 1500,
    "strip": ["button", "[aria-hidden=true]", ".sr-only"]
  },
  "errors": [
    { "within": ["[role=alert]", "[role=status]", "[data-testid*=error]", "[class*=toast]"],
      "match": "(rate limit|too many requests|reached (your|the) (message )?limit|usage limit|try again (later|in))",
      "code": "E_RATE_LIMITED", "message": "the site says you have reached its usage limit" }
  ],
  "limits": { "min_interval_ms": 4000, "max_prompt_chars": 30000 },
  "selftest": { "prompt": "Reply with exactly: ABP-OK", "expect": "ABP-OK" }
}
