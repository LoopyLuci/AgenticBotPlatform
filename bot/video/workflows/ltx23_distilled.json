  "image": {"type": "path", "default": ""},
  "seconds": {"type": "number", "default": 2, "min": 0.5, "max": 10},
  "fps": {"type": "int", "default": 24, "min": 8, "max": 24},
  "width": {"type": "int", "default": 832, "min": 256, "max": 1280, "multiple": 32},
  "height": {"type": "int", "default": 480, "min": 256, "max": 720, "multiple": 32},
  "steps": {"type": "int", "default": 8, "min": 1, "max": 30},
  "cfg": {"type": "number", "default": 1.0, "min": 1.0, "max": 10.0},
  "seed": {"type": "int", "default": -1, "min": -1, "max": 4294967295}
 },
 "args": ["-M", "vid_gen", "--diffusion-model", "{file:diffusion}", "--vae", "{file:vae}", "--audio-vae", "{file:audio_vae}",
          "--llm", "{file:llm}", "--embeddings-connectors", "{file:connectors}", "-p", "{prompt}", "-n", "{negative}",
          "--cfg-scale", "{cfg}", "--sampling-method", "euler", "--steps", "{steps}", "-W", "{width}", "-H", "{height}",
          "--video-frames", "{frames}", "--fps", "{fps}", "--offload-to-cpu", "--seed", "{seed}", "-v", "-o", "{output}"],
 "optional_args": {"image": ["-i", "{image}"]}}
