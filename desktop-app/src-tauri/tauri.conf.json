{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BotServer",
  "version": "0.7.12",
  "identifier": "com.botserver.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bot Server",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' http://127.0.0.1:* data:; style-src 'self' http://127.0.0.1:* 'unsafe-inline'; script-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../bot": "bot",
      "../../config": "config",
      "../../.venv": ".venv",
      "../../requirements.txt": "requirements.txt"
    }
  }
}
