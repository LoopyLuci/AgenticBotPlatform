<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required on Android 8+ to launch the system installer for an APK
         from a source other than the Play Store (see UpdateInstaller.kt) —
         the user still has to explicitly allow "install unknown apps" for
         this app once in Settings; this permission just lets us prompt
         that flow instead of the install silently failing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".BotServerApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.BotServerMobile"
        android:usesCleartextTraffic="true">
        <!--
          Cleartext (plain HTTP) is required: BotServer has no TLS of its
          own by design (see docs/mobile-access.md) — the intended transport
          is a Tailscale tunnel or a trusted LAN, both already private, so
          this app talks plain HTTP *to a private address*, never to the
          open internet directly.

          This is declared broadly here (rather than scoped via a
          network_security_config domain allow-list) because the actual
          host is whatever the user pairs to at runtime — unknown at build
          time, and Android's declarative config can only allow-list exact
          domains, not IP/CIDR ranges. The real enforcement of "private
          only" happens per-request instead, in
          di/NetworkModule.kt's DynamicHostInterceptor, which refuses to
          send the auth token in cleartext to any host that doesn't resolve
          into PrivateNetworkGuard's allowed Tailscale/RFC1918 ranges.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BotServerMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- botserver://pair?host=...&key=... deep link, for pairing via
                 a shared link as an alternative to scanning the QR directly. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="botserver" android:host="pair" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Lets DevicesScreen hand a content:// URI for its own copied APK
             to the OS share sheet — the installed app's real path
             (applicationInfo.sourceDir) isn't directly shareable. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
