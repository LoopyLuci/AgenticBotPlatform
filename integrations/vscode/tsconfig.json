{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler", "lib": ["ES2022"],
    "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "isolatedModules": true, "noEmit": true, "types": ["node", "vscode"]
  },
  "include": ["src", "test"]
}
